# ============================================================================
# SHINE — self-hosted stack (NestJS + PostgreSQL + Redis + MinIO + Socket.IO
#                           + LiveKit + Meilisearch)
# ============================================================================

# ------------------------- Core services -------------------------
PUBLIC_SITE_URL=https://shine.dejoiy.com
PUBLIC_API_URL=https://api.shine.dejoiy.com

# PostgreSQL
POSTGRES_USER=shine
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=shine
DATABASE_URL=postgres://shine:change-me-strong@postgres:5432/shine

# Redis (cache + Socket.IO adapter + queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Secrets
JWT_SECRET=generate-a-long-random-string
# access/refresh token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend / API
VITE_API_URL=/api          # browser origin; set http://localhost:3001 in dev
API_PORT=3001
FRONTEND_PORT=5173

# ------------------------- Object storage (MinIO) -------------------------
# Browser uploads go straight to MinIO via presigned URLs; the API server
# proxies them in production. NEVER store user media on the VPS disk.
MINIO_ENDPOINT=minio                 # container name on the docker network
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin          # = MINIO_ROOT_USER
MINIO_SECRET_KEY=change-me-strong    # = MINIO_ROOT_PASSWORD
MINIO_BUCKET=shine
# Public URL clients use to load media (CDN/Nginx domain recommended; the
# compose `minio-init` also creates a `shine-recordings` bucket for egress).
MINIO_PUBLIC_URL=https://media.shine.dejoiy.com
MINIO_CONSOLE_EXPOSE_PORT=9001

# ------------------------- Realtime (Socket.IO) -------------------------
SOCKET_CORS_ORIGIN=https://shine.dejoiy.com

# ------------------------- Meilisearch -------------------------
MEILI_MASTER_KEY=change-me-strong
MEILI_URL=http://meilisearch:7700
MEILI_ENV=production

# ------------------------- LiveKit (meetings SFU) -------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://livekit:7880
PUBLIC_LIVEKIT_URL=wss://livekit.shine.dejoiy.com
LIVEKIT_PORT=7880
# Room codes embed a DJM code segment; set a signing salt for the code/hash.
DJM_CODE_SALT=generate-a-random-salt

# ------------------------- SMTP (mail module) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SHINE <no-reply@shine.dejoiy.com>

# ------------------------- Auth providers -------------------------
AUTH_SECRET=generate-a-long-random-string

# ------------------------- Payments -------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------- AI (optional) -------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------- Observability (optional, not in core) ----------
NOVU_API_KEY=
GRAFANA_EXPOSE_PORT=3002