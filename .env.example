# ============================= Convex (backend) =============================

# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL. The frontend connects to
# this URL for auth + every query/mutation. Required to build the web container:
#   CONVEX_URL=https://<project>-<team>.convex.cloud
#   docker compose build web && docker compose up -d web
CONVEX_URL=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex site URL for auth (the deployment's *.convex.site URL; NOT the app URL).
CONVEX_SITE_URL=http://localhost:5173

# --- Convex deployment environment (Keys tab of your Convex deployment) ---
# AUTH_SECRET / BETTER_AUTH_SECRET  — signs Convex Auth OTP session JWTs
# RESEND_API_KEY                     — sends the 6-digit login OTPs (emailOtp.ts)
# CONVEX_SITE_URL                    — must match the deployment's *.convex.site
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET  (optional SSO, likewise for GITHUB /
#                                       MICROSOFT_ENTRA_ID / APPLE)

# ============================= App / Docker stack ============================

# Public origin used by the stack.
PUBLIC_SITE_URL=https://shine.dejoiy.com

# Secrets for the docker stack (setup.sh generates these automatically).
JWT_SECRET=
POSTGRES_USER=shine
POSTGRES_PASSWORD=
POSTGRES_DB=shine

# SMTP (used by the legacy NestJS API + notification services).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications / search.
NOVU_API_KEY=
MEILI_MASTER_KEY=

# LiveKit / TURN for meetings.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PUBLIC_LIVEKIT_URL=wss://livekit.example.com
TURN_URL=turn:meet.dejoiy.com:3478?transport=udp
TURN_USERNAME=
TURN_PASSWORD=